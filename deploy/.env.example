# Plantilla de referencia para deploy/compose.yaml.
# No contiene secretos reales.
# El bootstrap de testing genera automaticamente su configuracion privada.
# NO copiar esta plantilla encima de deploy/.testing/.env.
# Para uso manual, completar secretos y rutas antes de arrancar Compose.

# Password privada del administrador PostgreSQL.
POSTGRES_PASSWORD=

# Password privada del rol restringido core_app; usar otra diferente.
APP_DB_PASSWORD=

# Password privada del usuario core de RabbitMQ.
RABBITMQ_PASSWORD=

# Password inicial de las cuentas creadas por el seed.
SEED_INITIAL_PASSWORD=

# Origen permitido de la UI; debe coincidir con el puerto elegido.
CORS_ORIGINS=http://localhost:18088

# Puerto HTTP publicado exclusivamente en loopback.
CORE_HTTP_PORT=18088

# Etiqueta local de la imagen backend de testing.
CORE_BACKEND_IMAGE=muni-core-backend:testing

# Etiqueta local de la imagen frontend de testing.
CORE_FRONTEND_IMAGE=muni-core-frontend:testing

# Ruta al checkout del frontend aprobado; completar para uso manual.
CORE_FRONTEND_PATH=

# Ruta al archivo privado de firma RSA PEM; completar para uso manual.
JWT_PRIVATE_KEY_PATH=

# Dominio opcional, utilizado por el override HTTPS.
# CORE_DOMAIN=
