FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml requirements-deploy.lock ./
COPY app ./app
RUN pip install --no-cache-dir -r requirements-deploy.lock && pip install --no-cache-dir -e ".[dev]" && useradd --uid 10001 --create-home core
COPY integration_tests ./integration_tests
USER core
CMD ["python", "-m", "pytest", "integration_tests", "-v", "--tb=short", "-o", "cache_dir=/tmp/pytest-cache", "--junitxml=/evidence/integration.xml"]
