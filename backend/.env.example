# Configuracion local de desarrollo.
# Para el entorno "real" (Postgres + RabbitMQ) ver las lineas comentadas abajo.

ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---------------------------------------------------------
# SQLite: cero instalacion, arranca al instante. Suficiente para probar la API.
DATABASE_URL=sqlite+aiosqlite:///./muni_core.db
# PostgreSQL (recomendado, es el motor del deploy):
# DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/muni_core

# --- Broker ----------------------------------------------------------------
# memory:// = broker en memoria. Rutea de verdad (exchanges, colas, bindings),
# pero sin persistencia entre reinicios ni consumidores externos.
RABBITMQ_URL=memory://
# RabbitMQ real:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Seguridad -------------------------------------------------------------
# Sin JWT_PRIVATE_KEY se genera un par RSA efimero al arrancar: los tokens
# emitidos dejan de ser validos al reiniciar. Para produccion es obligatoria.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

SEED_ADMIN_EMAIL=admin@muni.uade.edu.ar
SEED_ADMIN_PASSWORD=Admin123!

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Notificaciones --------------------------------------------------------
# Sin SMTP_HOST los emails se registran como simulados (status SENT) y el flujo
# se puede demostrar completo sin servidor de correo.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=
# SMTP_PASSWORD=
